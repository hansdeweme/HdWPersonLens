@@ -0,0 +1,37 @@
+"""Compact, read-only person status summary built from existing service results."""
+from PyQt6.QtWidgets import QFormLayout, QGroupBox, QLabel
+
+
+def person_status_fields(state, readiness=None, provenance=None):
+    if state is None:
+        return {"Person record": "—", "KB images": "—", "Recognition bank": "—", "Readiness": "—"}
+    record = "Persons DB record" if state.database_record_exists else "Recognition-only; no DB record"
+    folder = "KB folder available" if state.knowledge_base_folder_exists else "No KB folder"
+    images = f"{state.image_count} image(s) · {folder}"
+    bank = f"{state.face_encodings} face / {state.body_encodings} body embedding(s)"
+    if provenance is None: bank += " · provenance not checked"
+    elif not isinstance(provenance, dict): bank += " · provenance unavailable"
+    else: bank += f" · provenance: {provenance.get('status', 'unknown')}"
+    status = readiness.get("status", "Not assessed") if isinstance(readiness, dict) else "Not assessed"
+    return {"Person record": record, "KB images": images, "Recognition bank": bank, "Readiness": status}
+
+
+class PersonStatusDashboard(QGroupBox):
+    """Displays existing facts; never reads sources, hashes media, or launches analyses."""
+
+    def __init__(self, parent=None):
+        super().__init__("Person at a glance", parent)
+        self.setObjectName("personStatusDashboard")
+        layout = QFormLayout(self)
+        self.fields = {}
+        for title in ("Person record", "KB images", "Recognition bank", "Readiness"):
+            label = QLabel("—")
+            label.setWordWrap(True)
+            layout.addRow(title + ":", label)
+            self.fields[title] = label
+        self.notice = QLabel("Technical readiness and embeddings do not establish identity.")
+        self.notice.setWordWrap(True)
+        layout.addRow(self.notice)
+
+    def set_status(self, state, readiness=None, provenance=None):
+        for title, value in person_status_fields(state, readiness, provenance).items(): self.fields[title].setText(value)
--- a/tests/test_person_status_dashboard_v1113.py
+++ b/tests/test_person_status_dashboard_v1113.py
@@ -0,0 +1,52 @@
+"""Read-only status dashboard contracts without importing Qt/native backends."""
+import ast
+from pathlib import Path
+from types import SimpleNamespace
+import unittest
+
+
+ROOT = Path(__file__).resolve().parents[1] / "hdw_person_lens"
+
+
+def _formatter():
+    source = (ROOT / "person_status_dashboard.py").read_text(encoding="utf-8")
+    node = next(node for node in ast.parse(source).body if isinstance(node, ast.FunctionDef) and node.name == "person_status_fields")
+    namespace = {}
+    exec(compile(ast.Module(body=[node], type_ignores=[]), "person_status_dashboard.py", "exec"), namespace)
+    return namespace["person_status_fields"]
+
+
+class PersonStatusDashboardTests(unittest.TestCase):
+    def setUp(self):
+        self.state = SimpleNamespace(database_record_exists=True, knowledge_base_folder_exists=True,
+                                     image_count=17, face_encodings=9, body_encodings=6)
+
+    def test_record_and_bank_counts(self):
+        result = _formatter()(self.state)
+        self.assertIn("Persons DB", result["Person record"])
+        self.assertIn("17 image", result["KB images"])
+        self.assertIn("9 face / 6 body", result["Recognition bank"])
+        self.assertIn("not checked", result["Recognition bank"])
+
+    def test_kb_only_and_provenance(self):
+        self.state.database_record_exists = False
+        result = _formatter()(self.state, {"status": "Review required"}, {"status": "stale"})
+        self.assertIn("Recognition-only", result["Person record"])
+        self.assertIn("stale", result["Recognition bank"])
+        self.assertEqual(result["Readiness"], "Review required")
+
+    def test_no_selection(self):
+        self.assertEqual(_formatter()(None)["Person record"], "—")
+
+    def test_existing_readiness_is_reused(self):
+        workbench = (ROOT / "persons_workbench.py").read_text(encoding="utf-8")
+        dashboard = (ROOT / "person_status_dashboard.py").read_text(encoding="utf-8")
+        self.assertIn("self.status_dashboard.set_status(state, readiness, report)", workbench)
+        self.assertIn("self.status_dashboard.set_status(None)", workbench)
+        self.assertIn("never reads sources, hashes media, or launches analyses", dashboard)
+        self.assertIn("do not establish identity", dashboard)
+        ast.parse(workbench)
+        ast.parse(dashboard)
+
+
+if __name__ == "__main__": unittest.main()
