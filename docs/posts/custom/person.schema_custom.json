{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/person.schema.json",
  "title": "Person",
  "description": "Person in the persons catalog",
  "type": "object",
  "properties": {
    "#person_id": {
      "description": "The unique identifier for a person",
      "type": "string"
    },
    "personName": {
      "type": "string"
    },
    "otherName": {
      "description": "Other name(s) used by the person",
      "type": "string"
    },
    "rating": {
      "type": "number",
      "minimum": 0,
      "maximum": 5
    },
    "birth date": {
      "type": "object",
      "properties": {
        "year": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2020
        },
        "month": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "day": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        }
      },
      "x-ui": {
        "layout": "inline"
      }
    },
    "birth_place": {
      "type": "string"
    },
    "colors": {
      "type": "object",
      "properties": {
        "skin": {
          "type": "string",
          "enum": [
            "light",
            "medium",
            "dark"
          ]
        },
        "hair": {
          "type": "string",
          "enum": [
            "blonde",
            "brown",
            "black",
            "red",
            "grey"
          ]
        }
      },
      "required": [
        "skin",
        "hair"
      ]
    },
    "face_shown": {
      "type": "boolean"
    },
    "shaved": {
      "type": "boolean"
    },
    "dimensions": {
      "type": "object",
      "properties": {
        "length": {
          "type": "integer",
          "minimum": 0
        },
        "weight": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "length",
        "weight"
     ]
    },
    "files_path": {
      "type": "string",
      "pattern": "^[A-Za-z]:\\\\.*"
    }
  },
  "required": [
    "personName",
    "rating",
    "colors",
    "scores",
    "files_path"
  ]
}