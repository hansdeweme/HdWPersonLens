+    def _save_view_preferences(self):
+        if not hasattr(self, "detail_tabs"): return
+        sizes = self.splitter.sizes()
+        share = sizes[0] / sum(sizes) if self._initial_split_applied and len(sizes) == 2 and sum(sizes) > 0 else None
