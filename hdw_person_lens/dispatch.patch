+    def _management_confirmation_state(self, name: str) -> tuple:
+        """Capture metadata revisions and this person's vectors without waiting on a writer.
+
+        File IDs/size/mtime detect replacements and normal edits without hashing
+        images on the GUI thread. This is not full source-content verification.
+        """
+        name = self._clean_name(name)
+        manager = self.knowledge_manager
+        if not manager._bank_lock.acquire(blocking=False):
+            raise PersonServiceError("Encoding bank is busy; review the operation after it finishes.")
+        try:
+            state = self.get_person_state(name)
+            folder = self._kb_folder(name)
+            paths = self.get_person_image_paths(name)
+            folder_stat = folder.stat() if folder.exists() else None
+            folder_id = (folder_stat.st_dev, folder_stat.st_ino) if folder_stat else None
+            file_ids = tuple((path, Path(path).stat().st_dev, Path(path).stat().st_ino)
+                             for path in sorted(paths))
+            bank = manager.persons
+            vectors = tuple((kind, tuple((index, vector) for index, (label, vector) in enumerate(
+                zip(bank.get(f"{kind}_names", []), bank.get(f"{kind}_encodings", []))) if label == name))
+                for kind in ("face", "body"))
+            metadata = bank.get("metadata") or {}
+            evidence = (vectors, metadata.get("body_pipeline"),
+                        (metadata.get("reference_provenance") or {}).get(name), self._person_record(name))
+            digest = hashlib.sha256(pickle.dumps(evidence, protocol=4)).hexdigest()
+            return state, str(folder), folder_id, source_snapshot(paths), file_ids, digest
+        finally:
+            manager._bank_lock.release()
+
